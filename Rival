    local touch = game:GetService("UserInputService").TouchEnabled and not game:GetService("UserInputService").MouseEnabled

    _windWindow = WindUI:CreateWindow({
        Title = "Velox Hub | Rivals",
        Icon = "crosshair",
        Author = "VeloxHub",
        Folder = "VeloxHubRivals",
        Size = touch and UDim2.fromOffset(410, 520) or UDim2.fromOffset(820, 650),
        MinSize = Vector2.new(touch and 330 or 560, touch and 360 or 420),
        MaxSize = Vector2.new(1000, 760),
        Theme = "VeloxDark",
        ToggleKey = Enum.KeyCode.RightShift,
        Resizable = true,
        HideSearchBar = false,
        ScrollBarEnabled = true,
        User = { Enabled = false },
    })

    _windowWrapper = {
        _wind = _windWindow,
        Tabs = {},
        Holder = nil,
    }

    function _windowWrapper:AddTab(name)
        local key = string.lower(tostring(name))
        local tabs = {
            changelog = {Title = "Changelog", Icon = "history", Desc = "Latest updates, fixes, and changes."},
            combat = {Title = "Combat", Icon = "crosshair", Desc = "Aim, targeting, and combat controls."},
            visuals = {Title = "Visuals", Icon = "eye", Desc = "Viewmodel, effects, and visual customization."},
            optimizations = {Title = "Performance", Icon = "gauge", Desc = "FPS, rendering, and performance settings."},
            misc = {Title = "Misc", Icon = "package", Desc = "Utility, spoofing, and miscellaneous tools."},
        }

        local meta = tabs[key] or {
            Title = tostring(name),
            Icon = "layout-dashboard",
            Desc = nil,
        }

        local actual = _windWindow:Tab({
            Title = meta.Title,
            Desc = meta.Desc,
            Icon = meta.Icon,
        })

        local wrapped = wrapTab(actual)
        self.Tabs[key] = wrapped
        self.Tabs[name] = wrapped
        return wrapped
    end

    function _windowWrapper:SetWindowTitle(title)
        if _windWindow.Tag then
            pcall(function() _windWindow:Tag({Title = tostring(title)}) end)
        end
    end

    function _windowWrapper:Toggle()
        if type(_windWindow.Toggle) == "function" then
            pcall(function() _windWindow:Toggle() end)
        end
    end

    function _windowWrapper:Open()
        if type(_windWindow.Open) == "function" then pcall(function() _windWindow:Open() end) end
    end

    function _windowWrapper:Close()
        if type(_windWindow.Close) == "function" then pcall(function() _windWindow:Close() end) end
    end

    function _windowWrapper:SetToggleKey(code)
        if type(_windWindow.SetToggleKey) == "function" and code then
            pcall(function() _windWindow:SetToggleKey(code) end)
        end
    end

    return _windowWrapper
end

function Library:OnUnload(callback)
    if type(callback) == "function" then
        table.insert(_unloadCallbacks, callback)
        if _windWindow and type(_windWindow.OnDestroy) == "function" then
            pcall(function() _windWindow:OnDestroy(callback) end)
        end
    end
end

