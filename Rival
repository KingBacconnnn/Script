local function buildEspTab()
    local esp_tab = Tabs.esptab

    local master = esp_tab:AddLeftGroupbox("ESP")

    master:AddToggle("esp_enable", {
        Text = "Enable ESP",
        Default = false,
        Callback = function(v)
            ELI.esp.enable = v
            if not v then
                for _, player in players:GetPlayers() do
                    if player ~= local_player then
                        esp.hide(player)
                    end
                end
            end
        end,
    })
    master:AddToggle("esp_box_enable", {
        Text = "Box",
        Default = ELI.esp.box.enable,
        Callback = function(v) ELI.esp.box.enable = v end,
    })
    master:AddToggle("esp_health_enable", {
        Text = "Health Bar",
        Default = ELI.esp.health.enable,
        Callback = function(v) ELI.esp.health.enable = v end,
    })
    master:AddToggle("esp_name_enable", {
        Text = "Name",
        Default = ELI.esp.text.name.enable,
        Callback = function(v) ELI.esp.text.name.enable = v end,
    })
    master:AddToggle("esp_distance_enable", {
        Text = "Distance",
        Default = ELI.esp.text.studs.enable,
        Callback = function(v) ELI.esp.text.studs.enable = v end,
    })
    master:AddToggle("esp_highlight_enable", {
        Text = "Highlight",
        Default = ELI.esp.highlight.enable,
        Callback = function(v) ELI.esp.highlight.enable = v end,
    })

    local filters = esp_tab:AddRightGroupbox("Filters")

    filters:AddToggle("esp_team_check", {
        Text = "Team Check",
        Default = ELI.esp.team_check,
        Callback = function(v)
            ELI.esp.team_check = v
