local function safeCall(fn, ...)
    if type(fn) ~= "function" then
        return nil
    end
    local ok, result = pcall(fn, ...)
    if ok then return result end
end

local function trySet(actual, value)
    if not actual then return false end
    if type(actual.Set) == "function" then
        local ok = pcall(function() actual:Set(value) end)
        if ok then return true end
    end
    if type(actual.SetValue) == "function" then
        local ok = pcall(function() actual:SetValue(value) end)
        if ok then return true end
    end
    if type(actual.Select) == "function" then
        local ok = pcall(function() actual:Select(value) end)
        if ok then return true end
    end
    return false
end

local function setVisible(actual, visible)
    if not actual then return end
    local ok = false
    if type(actual.SetVisible) == "function" then
        ok = pcall(function() actual:SetVisible(visible) end)
    end
    if not ok and type(actual.SetVisibility) == "function" then
        ok = pcall(function() actual:SetVisibility(visible) end)
    end
    if not ok then
        if visible and type(actual.Unlock) == "function" then
            pcall(function() actual:Unlock() end)
        elseif (not visible) and type(actual.Lock) == "function" then
            pcall(function() actual:Lock() end)
        end
    end
end

local function normalizeKey(key)
    if type(key) ~= "string" then return "None" end
    if key == "" or key == "..." then return "None" end
    return key
end

local function normalizeDropdownDefault(values, defaultValue, allowNull, multi)
    if multi then
        return defaultValue
    end
    if type(defaultValue) == "number" then
        return values[defaultValue]
    end
    if type(defaultValue) == "table" then
        if #defaultValue > 0 then
            return defaultValue[1]
        end
        return allowNull and nil or values[1]
    end
    if defaultValue == nil or defaultValue == "" and allowNull then
        return allowNull and nil or values[1]
    end
    return defaultValue
end

local function makeElementWrapper(actual, index, bucket, info)
    local wrapper = {
        _wind = actual,
        Index = index,
        Type = info and info.Type,
        Value = info and info.Default,
        Visible = info and info.Visible ~= false,
    }

    function wrapper:SetValue(value)
        self.Value = value
        if not trySet(self._wind, value) and info and info.Callback then
            safeCall(info.Callback, value)
        end
    end

    function wrapper:Set(value)
        self:SetValue(value)
    end

    function wrapper:SetVisible(value)
        self.Visible = not not value
        setVisible(self._wind, self.Visible)
    end

    function wrapper:OnChanged(callback)
        self._changed = callback
        safeCall(callback, self.Value)
    end

    function wrapper:SetTitle(title)
        if self._wind and type(self._wind.SetTitle) == "function" then
            pcall(function() self._wind:SetTitle(title) end)
        end
    end

    function wrapper:SetDesc(desc)
        if self._wind and type(self._wind.SetDesc) == "function" then
            pcall(function() self._wind:SetDesc(desc) end)
        end
    end

    function wrapper:SetValues(values)
        self.Values = values
        if self._wind and type(self._wind.Refresh) == "function" then
            pcall(function() self._wind:Refresh(values) end)
        elseif self._wind and type(self._wind.SetValues) == "function" then
            pcall(function() self._wind:SetValues(values) end)
        end
    end

    function wrapper:SetValueRGB(color)
        self:SetValue(color)
    end

    function wrapper:SetText(text)
        self.Value = text
        if self._wind and type(self._wind.SetTitle) == "function" then
            pcall(function() self._wind:SetTitle(text) end)
        end
    end

    function wrapper:AddColorPicker(idx, colorInfo)
        local ci = colorInfo or {}
        colorInfo = ci
        local holder = self._holder or self._section or self._tab
        if not holder then return self end
        local opt
        local actualColor = holder:Colorpicker({
            Title = ci.Title or ci.Text or idx,
            Desc = ci.Desc,
            Default = ci.Default or Color3.fromRGB(255,255,255),
            Transparency = ci.Transparency or 0,
            Callback = function(color)
                if opt then opt.Value = color end
                if ci.Callback then safeCall(ci.Callback, color) end
            end,
        })
        opt = makeElementWrapper(actualColor, idx, Options, {
            Type = "Colorpicker",
            Default = ci.Default or Color3.fromRGB(255,255,255),
            Callback = ci.Callback,
        })
        opt.Values = nil
        Options[idx] = opt
        return self
    end

    function wrapper:AddKeyPicker(idx, keyInfo)
        local ki = keyInfo or {}
        local holder = self._holder or self._section or self._tab
        if not holder then return self end

        local defaultKey = normalizeKey(ki.Default)
        local mode = ki.Mode or "Toggle"
        local keyObj
        local actualKey

        local function normalizePressedKey(value)
            if typeof(value) == "EnumItem" then
                return value.Name
            end
            if type(value) ~= "string" then
                return "None"
            end
            if value == "MouseButton1" then
                return "MB1"
            elseif value == "MouseButton2" then
                return "MB2"
            end
            return value
        end

        local function matchesInput(value, input)
            value = normalizePressedKey(value)

            if value == "None" or value == "" then
                return false
            end

            if value == "MB1" then
                return input.UserInputType == Enum.UserInputType.MouseButton1
            elseif value == "MB2" then
                return input.UserInputType == Enum.UserInputType.MouseButton2
            end

            return input.UserInputType == Enum.UserInputType.Keyboard
                and input.KeyCode.Name == value
        end

        actualKey = holder:Keybind({
            Title = ki.Text or ki.Title or idx,
            Desc = ki.Desc,
            Value = defaultKey,
            Callback = function(value)
                if keyObj then
                    keyObj.Value = normalizePressedKey(value)
                end

            end,
        })

        keyObj = makeElementWrapper(actualKey, idx, Options, {
            Type = "Keybind",
            Default = defaultKey,
            Callback = ki.Callback,
        })
        keyObj.Value = defaultKey
        keyObj.Mode = mode
        keyObj.Toggled = false
        keyObj.EnableCheck = ki.EnableCheck
        Options[idx] = keyObj

        local inputService = game:GetService("UserInputService")
        local endedConnection

        local beganConnection = inputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then
                return
            end

            if not matchesInput(keyObj.Value, input) then
                return
            end

            if keyObj.Mode == "Hold" then
                keyObj.Toggled = true
            elseif keyObj.Mode == "Always" then
                keyObj.Toggled = true
            else
                keyObj.Toggled = not keyObj.Toggled
            end

            if ki.Callback then
                safeCall(ki.Callback, keyObj.Toggled)
            end
        end)

        endedConnection = inputService.InputEnded:Connect(function(input)
            if not matchesInput(keyObj.Value, input) then
                return
            end

            if keyObj.Mode == "Hold" then
                keyObj.Toggled = false
                if ki.Callback then
                    safeCall(ki.Callback, false)
                end
            end
        end)

        table.insert(_unloadCallbacks, function()
            pcall(function() beganConnection:Disconnect() end)
            pcall(function() endedConnection:Disconnect() end)
        end)

        if idx == "MenuKeybind" and _windWindow and _windWindow.SetToggleKey then
            local code = Enum.KeyCode[defaultKey]
            if code then
                pcall(function()
                    _windWindow:SetToggleKey(code)
                end)
            end
        end

        return self
    end

    if bucket then
        bucket[index] = wrapper
    end
    return wrapper
end

