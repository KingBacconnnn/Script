local function do_inject(json)
    local injector = getgenv().FourHub_inject_fflags;
    if not injector then
        WindUI:Notify({ Title = "FourHub", Content = "fflags injector not ready", Duration = 4, Icon = "lucide:alert-triangle" });
        return
    end
    local res = injector(json);
    if not res or not res.ok then
        WindUI:Notify({ Title = "FourHub", Content = "fflags: " .. ((res and res.reason) or "failed"), Duration = 4, Icon = "lucide:alert-triangle" });
        return
    end
    if res.live and res.applied > 0 then
        WindUI:Notify({ Title = "FourHub", Content = string.format("fflags applied %d/%d live - rejoin to fully apply", res.applied, res.total), Duration = 6, Icon = "lucide:zap" });
    elseif res.saved then
        WindUI:Notify({ Title = "FourHub", Content = "fflags saved to FourHub/fflags.json - import in your executor & rejoin", Duration = 7, Icon = "lucide:save" });
    else
        WindUI:Notify({ Title = "FourHub", Content = "your executor cannot set fflags from a script", Duration = 5, Icon = "lucide:alert-triangle" });
    end
end

