function ContainerMethods:AddLabel(text, doesWrap)
    local labelText = text
    local wrap = doesWrap == true

    if type(doesWrap) == "table" then
        local info = doesWrap
        labelText = info.Text or info.Title or text
        wrap = info.DoesWrap == true or info.TextWrapped == true
    end

    local section = self._section or self._tab
    local actual = section:Paragraph({
        Title = tostring(labelText or ""),
        Desc = wrap and "" or nil,
    })
    local wrapper = makeElementWrapper(actual, nil, nil, {
        Type = "Label",
        Default = labelText,
    })
    wrapper._section = section
    wrapper._holder = section
    function wrapper:SetText(value)
        self.Value = value
        if self._wind and type(self._wind.SetTitle) == "function" then
            pcall(function() self._wind:SetTitle(tostring(value or "")) end)
        end
    end
    return wrapper
end

function ContainerMethods:AddButton(idxOrText, infoOrCallback)
    local title, callback
    if type(idxOrText) == "table" then
        title = idxOrText.Text or idxOrText.Title or "Button"
        callback = idxOrText.Func or idxOrText.Callback
    else
        title = tostring(idxOrText or "Button")
        if type(infoOrCallback) == "function" then
            callback = infoOrCallback
        elseif type(infoOrCallback) == "table" then
            callback = infoOrCallback.Func or infoOrCallback.Callback
        end
    end
    local host = self._section or self._tab
    local actual = host:Button({
        Title = title,
        Desc = nil,
        Callback = function()
            safeCall(callback)
        end,
    })
    local wrapper = makeElementWrapper(actual, nil, nil, { Type = "Button" })
    wrapper._holder = self._section
    wrapper._section = self._section
    function wrapper:AddButton(text, cb)
        (self._holder or self._section or self._tab):Button({
            Title = tostring(text or "Button"),
            Callback = function() safeCall(cb) end,
        })
        return self
    end
    return wrapper
end

function ContainerMethods:AddToggle(idx, info)
    info = info or {}
    local host = self._section or self._tab
    local wrapper
    local actual = host:Toggle({
        Title = info.Text or idx,
        Desc = info.Desc,
        Value = info.Default == true,
        Callback = function(value)
            if wrapper then wrapper.Value = value end
            safeCall(info.Callback, value)
        end,
    })
    wrapper = makeElementWrapper(actual, idx, Toggles, {
        Type = "Toggle",
        Default = info.Default == true,
        Callback = info.Callback,
        Visible = info.Visible,
    })
    wrapper.Value = info.Default == true
    wrapper._holder = self._section
    wrapper._section = self._section
    return wrapper
end

function ContainerMethods:AddSlider(idx, info)
    info = info or {}
    local rounding = tonumber(info.Rounding) or 0
    local step = 1 / (10 ^ math.max(0, rounding))
    local host = self._section or self._tab
    local wrapper
    local actual = host:Slider({
        Title = info.Text or idx,
        Desc = info.Desc,
        Step = step,
        Value = {
            Min = info.Min,
            Max = info.Max,
            Default = info.Default,
        },
        Callback = function(value)
            if wrapper then wrapper.Value = value end
            safeCall(info.Callback, value)
        end,
    })
    wrapper = makeElementWrapper(actual, idx, Options, {
        Type = "Slider",
        Default = info.Default,
        Callback = info.Callback,
        Visible = info.Visible,
    })
    wrapper.Value = info.Default
    wrapper._holder = self._section
    wrapper._section = self._section
    return wrapper
end

function ContainerMethods:AddDropdown(idx, info)
    info = info or {}
    local defaultValue = info.Default
    if defaultValue == nil and info.AllowNull then defaultValue = nil end
    local host = self._section or self._tab
    local values = info.Values or {}
    local defaultValue = normalizeDropdownDefault(values, info.Default, info.AllowNull == true, info.Multi == true)
    local wrapper
    local actual = host:Dropdown({
        Title = info.Text or idx,
        Desc = info.Desc,
        Values = values,
        Value = defaultValue,
        AllowNone = info.AllowNull == true,
        Multi = info.Multi == true,
        Callback = function(value)
            if wrapper then wrapper.Value = value end
            safeCall(info.Callback, value)
        end,
    })
    pcall(function()
        if type(actual.Close) == "function" then
            actual:Close()
        end
    end)
    wrapper = makeElementWrapper(actual, idx, Options, {
        Type = "Dropdown",
        Default = defaultValue,
        Callback = info.Callback,
        Visible = info.Visible,
    })
    wrapper.Value = defaultValue
    wrapper.Values = values
    wrapper.Multi = info.Multi == true
    wrapper._holder = self._section
    wrapper._section = self._section
    return wrapper
end

function ContainerMethods:AddInput(idx, info)
    info = info or {}
    local host = self._section or self._tab
    local wrapper
    local actual = host:Input({
        Title = info.Text or idx,
        Desc = info.Desc,
        Value = info.Default or "",
        Placeholder = info.Placeholder,
        Type = info.Type or (info.TextBox and "Textarea" or "Input"),
        Callback = function(value)
            if wrapper then wrapper.Value = value end
            safeCall(info.Callback, value)
        end,
    })
    wrapper = makeElementWrapper(actual, idx, Options, {
        Type = "Input",
        Default = info.Default or "",
        Callback = info.Callback,
        Visible = info.Visible,
    })
    wrapper.Value = info.Default or ""
    wrapper.Text = wrapper.Value
    wrapper._holder = self._section
    wrapper._section = self._section
    return wrapper
end

