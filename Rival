Heartbeat:Connect(LPH_NO_VIRTUALIZE(function()
    local ok = pcall(function()
        if not ELI.animation.enable then stopCustomAnimation(); return end;
        local character = local_player.Character;
        if not character then stopCustomAnimation(); return end;
        local humanoid = character:FindFirstChildOfClass("Humanoid");
        if not humanoid then stopCustomAnimation(); return end;
        local animator = humanoid:FindFirstChildOfClass("Animator");
