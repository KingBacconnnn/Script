local function shim(el)
    if el and not el.SetVisible then
        el.SetVisible = function(_, v)
            if v then pcall(function() el:Unlock() end) else pcall(function() el:Lock() end) end;
        end;
    end;
    if el and not el.SetValue and el.Set then
        el.SetValue = function(_, v) pcall(function() el:Set(v) end) end;
    end;
    if el and not el.OnChanged and el.OnChange then
        el.OnChanged = function(_, fn) pcall(function() el:OnChange(fn) end) end;
    end
    return el;
end

