local function runUnloadCallbacks()
    if _unloadCallbacksRan then return end
    _unloadCallbacksRan = true

    for _, callback in ipairs(_unloadCallbacks) do
        safeCall(callback)
    end
end

function Library:OnUnload(callback)
    if type(callback) ~= "function" then
        return
    end

    _unloadCallbacks[#_unloadCallbacks + 1] = callback

    if not _unloadHooked and _windWindow and type(_windWindow.OnDestroy) == "function" then
        _unloadHooked = true
        pcall(function()
            _windWindow:OnDestroy(runUnloadCallbacks)
        end)
    end
end

function Library:Notify(message, duration)
    if getgenv().silent_load then
        return nil
    end
    local text = tostring(message or "")
    local d = tonumber(duration) or 3
    local ok, result = pcall(function()
        return WindUI:Notify({
            Title = "Velox Hub | Rivals",
            Content = text,
            Duration = d,
            Icon = "info",
        })
    end)
    if ok then return result end
end

function Library:Unload()
    if self.Unloaded then return end
    self.Unloaded = true
    runUnloadCallbacks()

    if _windWindow and type(_windWindow.Close) == "function" then
        pcall(function() _windWindow:Close() end)
    end

    if _windWindow and type(_windWindow.Destroy) == "function" then
        pcall(function() _windWindow:Destroy() end)
    end
end

function Library:Toggle()
    if _windWindow and type(_windWindow.Toggle) == "function" then
        pcall(function() _windWindow:Toggle() end)
    end
end

